<?xml version="1.0" encoding="utf-8"?>
<!-- Значок выбора: круг акцентного цвета с белой окантовкой; галочка — цветом
     «на акценте», поэтому видна при любом акценте (в т.ч. белом «Авто»). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/gxAccent" />
    <stroke
        android:width="2dp"
        android:color="@color/white" />
</shape>
