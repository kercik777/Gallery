<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка-«герой» экрана настроек (маскировка): поверхность темы с мягким
     градиентом и тонким стеклянным краем — одинаково уместна в тёмной и светлой теме
     и при любом акценте (в отличие от акцентного градиента, который в «Авто»-акценте
     тёмной темы становился молочно-белым). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="315"
        android:endColor="?attr/gxSurfaceAlt"
        android:startColor="?attr/gxSurfaceHigh" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glassStroke" />
</shape>
