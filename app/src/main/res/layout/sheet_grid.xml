<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_l">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chip_active" />

    <TextView
        android:id="@+id/txtGridTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_xl"
        android:text="@string/settings_grid"
        android:textColor="@color/textPrimary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtGridValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/spacing_xl"
        android:text="@string/grid_value"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderColumns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:stepSize="1"
        android:valueFrom="2"
        android:valueTo="6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingEnd="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_l"
        android:text="@string/grid_hint"
        android:textColor="@color/textTertiary"
        android:textSize="12sp" />
</LinearLayout>
