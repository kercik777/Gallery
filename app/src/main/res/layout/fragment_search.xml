<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Поиск» в стиле GorillaGallery: крупный заголовок, стеклянная строка поиска,
     недавние запросы + категории при пустом запросе, сетка результатов при вводе -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/gxBg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_s"
        android:paddingTop="@dimen/spacing_s"
        android:paddingEnd="@dimen/spacing_l">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/textPrimary" />

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.03"
            android:text="@string/search_title"
            android:textColor="@color/textPrimary"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Стеклянная строка поиска -->
    <LinearLayout
        android:id="@+id/layoutSearchRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_m"
        android:layout_marginEnd="@dimen/spacing_l"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/search_title"
            android:src="@drawable/ic_search"
            app:tint="@color/textSecondary" />

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_placeholder"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textTertiary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btnSearchClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/textSecondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Панель «что искать», видна при пустом запросе -->
        <ScrollView
            android:id="@+id/discoverScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="40dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/discoverRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="1dp"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="1dp"
            android:paddingBottom="20dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <include
            android:id="@+id/layoutEmpty"
            layout="@layout/view_empty" />

        <include
            android:id="@+id/layoutLoading"
            layout="@layout/view_loading" />
    </FrameLayout>
</LinearLayout>
