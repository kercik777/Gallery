<?xml version="1.0" encoding="utf-8"?>
<!-- Файл в группе дубликатов: миниатюра · имя/папка/размер+дата · «i» · кружок выбора -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowDupFile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_m"
    android:paddingTop="@dimen/spacing_m"
    android:paddingEnd="@dimen/spacing_s"
    android:paddingBottom="@dimen/spacing_m">

    <androidx.cardview.widget.CardView
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardBackgroundColor="?attr/gxSurfaceAlt"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgDupCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:contentDescription="@string/dup_preview"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtDupName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/textPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtDupBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_accent"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="@string/dup_badge_oldest"
                android:textColor="?attr/gxAccent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDupFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/textSecondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtDupMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textColor="@color/textTertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnDupInfo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_glass_round"
        android:contentDescription="@string/action_info"
        android:padding="8dp"
        android:src="@drawable/ic_info"
        app:tint="@color/textSecondary" />

    <ImageView
        android:id="@+id/imgDupCheck"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="@dimen/spacing_s"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:contentDescription="@string/dup_select"
        android:padding="4dp"
        app:tint="?attr/gxOnAccent" />
</LinearLayout>
