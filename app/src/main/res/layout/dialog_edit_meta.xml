<?xml version="1.0" encoding="utf-8"?>
<!-- Диалог «Изменить» из свойств файла: имя, дата и время съёмки -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xxl"
    android:paddingTop="@dimen/spacing_s"
    android:paddingEnd="@dimen/spacing_xxl">

    <TextView
        style="@style/InfoSectionTitle"
        android:layout_marginStart="4dp"
        android:text="@string/info_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_m">

        <EditText
            android:id="@+id/editMetaName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtMetaExt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textTertiary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        style="@style/InfoSectionTitle"
        android:layout_marginStart="4dp"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="@string/meta_date_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/rowMetaDate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_m"
            android:paddingEnd="@dimen/spacing_m">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_clock"
                app:tint="?attr/gxAccent" />

            <TextView
                android:id="@+id/txtMetaDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/textPrimary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtMetaTime"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:minWidth="84dp"
            android:paddingStart="@dimen/spacing_m"
            android:paddingEnd="@dimen/spacing_m"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="10dp"
        android:text="@string/meta_date_hint"
        android:textColor="@color/textTertiary"
        android:textSize="12sp" />
</LinearLayout>
