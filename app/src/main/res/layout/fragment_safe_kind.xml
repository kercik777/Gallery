<?xml version="1.0" encoding="utf-8"?>
<!-- Сейф: папки одного раздела (Изображения или Видео) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/gxBg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerRoot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_h"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_m">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:background="@drawable/bg_glass_round"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/textPrimary" />

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/headerTools"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/btnNewFolder"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/create_folder"
                android:padding="9dp"
                android:src="@drawable/ic_folder_plus"
                app:tint="?attr/gxAccent" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSafeFolders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_s"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_xl" />
</LinearLayout>
