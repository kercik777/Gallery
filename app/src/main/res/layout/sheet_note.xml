<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_m">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle" />

    <!-- Шапка: иконка, заголовок, имя файла, кнопка закрытия -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_s">

        <!-- Удалить заметку (видна, только когда заметка уже есть) -->
        <ImageView
            android:id="@+id/btnNoteDelete"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_rounded"
            android:clickable="true"
            android:contentDescription="@string/note_delete_title"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/danger" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/note_title"
                android:textColor="@color/textPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNoteFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnNoteClose"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:tint="@color/textSecondary" />
    </LinearLayout>

    <EditText
        android:id="@+id/editNoteTitle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/spacing_xl"
        android:layout_marginTop="@dimen/spacing_l"
        android:layout_marginEnd="@dimen/spacing_xl"
        android:background="@drawable/bg_input"
        android:fontFamily="sans-serif-medium"
        android:hint="@string/note_title_hint"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_l"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editNoteBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_xl"
        android:layout_marginTop="@dimen/spacing_m"
        android:layout_marginEnd="@dimen/spacing_xl"
        android:layout_weight="1"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="@string/note_body_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:lineSpacingExtra="4dp"
        android:minHeight="160dp"
        android:overScrollMode="ifContentScrolls"
        android:padding="@dimen/spacing_l"
        android:scrollbars="vertical"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtNoteMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:textColor="@color/textTertiary"
        android:textSize="12sp" />

    <!-- Низ: Просмотр/Редактировать + Сохранить (в режиме правки) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_s"
        android:paddingEnd="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_l">

        <TextView
            android:id="@+id/btnNoteMode"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/note_mode_edit"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnNoteSave"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1.2"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/save"
            android:textColor="?attr/gxOnAccent"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
