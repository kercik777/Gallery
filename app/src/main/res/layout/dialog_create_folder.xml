<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xxl"
    android:paddingTop="@dimen/spacing_l"
    android:paddingEnd="@dimen/spacing_xxl"
    android:paddingBottom="@dimen/spacing_s">

    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/create_folder"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editFolderName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/spacing_l"
        android:background="@drawable/bg_input"
        android:hint="@string/folder_name_hint"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_l"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textTertiary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtFolderPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:ellipsize="middle"
        android:maxLines="2"
        android:textColor="@color/textSecondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtFolderError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:text="@string/invalid_folder_name"
        android:textColor="@color/danger"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
