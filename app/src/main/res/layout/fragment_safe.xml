<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/gxBg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerRoot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_h"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_m">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:background="@drawable/bg_glass_round"
            android:contentDescription="@string/nav_gallery"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/textPrimary" />

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:text="@string/safe_title"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/headerTools"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/btnHideNow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/hide_now"
                android:padding="9dp"
                android:src="@drawable/ic_hide"
                android:visibility="gone"
                app:tint="?attr/gxAccent" />

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/search_hint"
                android:padding="9dp"
                android:src="@drawable/ic_search"
                app:tint="@color/textPrimary" />

            <ImageView
                android:id="@+id/btnSort"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/sort_title"
                android:padding="9dp"
                android:src="@drawable/ic_sort"
                app:tint="@color/textPrimary" />

            <ImageView
                android:id="@+id/btnHeaderExtra"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/safe_lock_btn"
                android:padding="9dp"
                android:src="@drawable/ic_lock"
                app:tint="?attr/gxAccent" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSearchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_m"
        android:visibility="gone">

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/spacing_l"
            android:paddingEnd="@dimen/spacing_l"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textTertiary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btnSearchClose"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:tint="@color/textSecondary" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/chipRow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_l"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_s">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:background="@drawable/bg_chip_active"
                android:paddingStart="16dp"
                android:paddingTop="7dp"
                android:paddingEnd="16dp"
                android:paddingBottom="7dp"
                android:text="@string/filter_all"
                android:textColor="?attr/gxAccent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chipPhotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:background="@drawable/bg_chip"
                android:paddingStart="16dp"
                android:paddingTop="7dp"
                android:paddingEnd="16dp"
                android:paddingBottom="7dp"
                android:text="@string/filter_photo"
                android:textColor="@color/textSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chipVideos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="16dp"
                android:paddingTop="7dp"
                android:paddingEnd="16dp"
                android:paddingBottom="7dp"
                android:text="@string/filter_video"
                android:textColor="@color/textSecondary"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:paddingBottom="20dp"
            android:scrollbars="none" />

        <include
            android:id="@+id/layoutEmpty"
            layout="@layout/view_empty" />

        <include
            android:id="@+id/layoutLoading"
            layout="@layout/view_loading" />
    </FrameLayout>

</LinearLayout>
