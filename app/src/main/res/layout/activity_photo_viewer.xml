<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Верх: круглая «назад», капсула «день недели / время», круглая «ещё».
         Панель прозрачная, стекло — у самих кнопок. -->
    <FrameLayout
        android:id="@+id/viewerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnViewerBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/close"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <LinearLayout
            android:id="@+id/pillViewerDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_capsule"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/txtViewerDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtViewerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/viewerTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnViewerMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/viewer_options"
            android:padding="12dp"
            android:src="@drawable/ic_more"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Низ: капсула плеера (только для видео) и капсула действий -->
    <LinearLayout
        android:id="@+id/viewerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layoutVideoCtl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_glass_capsule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnVwPlay"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/play"
                android:padding="4dp"
                android:src="@drawable/ic_pause"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/txtVwCur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:minWidth="38dp"
                android:gravity="center"
                android:textColor="@color/viewerTextSecondary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekVw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:progressBackgroundTint="#4DFFFFFF"
                android:progressTint="@color/white"
                android:thumbTint="@color/white" />

            <TextView
                android:id="@+id/txtVwDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:minWidth="38dp"
                android:gravity="center"
                android:textColor="@color/viewerTextSecondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/btnVwMute"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/video_sound"
                android:padding="4dp"
                android:src="@drawable/ic_volume_off"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnVwRotate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/viewer_rotate_screen"
                android:padding="4dp"
                android:src="@drawable/ic_rotate"
                app:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillViewerActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_capsule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/btnVwFavorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/action_favorite"
                android:padding="12dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnVwShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/action_share"
                android:padding="12dp"
                android:src="@drawable/ic_share"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnVwEdit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/viewer_edit"
                android:padding="12dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnVwRestore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/action_restore"
                android:padding="12dp"
                android:src="@drawable/ic_restore"
                android:visibility="gone"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnVwDelete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/delete"
                android:padding="12dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnVwInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/action_info"
                android:padding="12dp"
                android:src="@drawable/ic_info"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
