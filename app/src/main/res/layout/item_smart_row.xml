<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/viewSmartDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="68dp"
        android:layout_marginEnd="16dp"
        android:background="@color/glassStroke" />

    <LinearLayout
        android:id="@+id/rowSmart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="11dp"
        android:paddingEnd="14dp"
        android:paddingBottom="11dp">

        <ImageView
            android:id="@+id/imgSmartIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_round"
            android:contentDescription="@null"
            android:padding="8dp"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txtSmartLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:textColor="@color/textPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtSmartCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imgSmartChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron"
            app:tint="@color/textTertiary" />
    </LinearLayout>
</LinearLayout>
