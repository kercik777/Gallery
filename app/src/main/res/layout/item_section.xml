<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_l"
    android:paddingTop="@dimen/spacing_xl"
    android:paddingEnd="@dimen/spacing_l"
    android:paddingBottom="@dimen/spacing_s">

    <View
        android:id="@+id/viewDivider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSectionAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/gxAccent"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
