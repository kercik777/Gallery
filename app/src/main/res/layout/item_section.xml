<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_l"
    android:paddingTop="@dimen/spacing_xxl"
    android:paddingEnd="@dimen/spacing_l"
    android:paddingBottom="@dimen/spacing_s">

    <View
        android:id="@+id/viewDivider"
        android:layout_width="34dp"
        android:layout_height="4dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_chip_active" />

    <TextView
        android:id="@+id/txtSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:textAllCaps="true"
        android:textColor="@color/textSecondary"
        android:textSize="13sp" />
</LinearLayout>
