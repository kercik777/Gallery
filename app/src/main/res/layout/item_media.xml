<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp">

    <com.premiumlab.galleryx.ui.view.SquareCardView
        android:id="@+id/cardMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/surfaceAlt"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/placeholder_media"
                android:contentDescription="@string/nav_gallery"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/viewDim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/scrim"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgFavBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|top"
                android:layout_margin="8dp"
                android:background="@drawable/bg_badge_dark"
                android:contentDescription="@string/favorites_title"
                android:padding="4dp"
                android:src="@drawable/ic_star_filled"
                android:visibility="gone"
                app:tint="@color/gold" />

            <TextView
                android:id="@+id/txtMediaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="8dp"
                android:background="@drawable/bg_badge_dark"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutVideoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:layout_margin="8dp"
                android:background="@drawable/bg_badge_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/imgPlayBadge"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@string/filter_video"
                    android:src="@drawable/ic_play"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/txtDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgCheckSel"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end|bottom"
                android:layout_margin="8dp"
                android:background="@drawable/bg_check_badge"
                android:contentDescription="@string/select_all"
                android:padding="6dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/primary" />
        </FrameLayout>
    </com.premiumlab.galleryx.ui.view.SquareCardView>
</FrameLayout>
