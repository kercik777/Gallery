<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/gxBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_h_main"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_m">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:text="@string/albums_title"
            android:textColor="@color/textPrimary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/headerTools"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/btnHideNowAlbums"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/hide_now"
                android:padding="9dp"
                android:src="@drawable/ic_hide"
                            android:visibility="gone"
                app:tint="?attr/gxAccent" />

            <ImageView
                android:id="@+id/btnNewFolder"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/create_folder"
                android:padding="9dp"
                android:src="@drawable/ic_folder_plus"
                app:tint="?attr/gxAccent" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAlbums"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_s"
            android:paddingBottom="104dp"
            android:scrollbars="none" />

        <include
            android:id="@+id/layoutEmptyAlbums"
            layout="@layout/view_empty" />

        <include
            android:id="@+id/layoutLoadingAlbums"
            layout="@layout/view_loading" />
    </FrameLayout>
</LinearLayout>
