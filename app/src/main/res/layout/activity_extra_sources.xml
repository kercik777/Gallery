<?xml version="1.0" encoding="utf-8"?>
<!-- Дополнительные источники: папки с фото/видео, которых нет в обычной галерее
     (скрытые, Android/media, Documents…). Переключатели включают их в галерею. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/gxBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_h"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_m">

        <ImageView
            android:id="@+id/btnSourcesBack"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:background="@drawable/bg_glass_round"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/textPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="@string/sources_title"
                android:textColor="@color/textPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSourcesStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSourcesRescan"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:background="@drawable/bg_glass_round"
            android:contentDescription="@string/sources_rescan"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/gxAccent" />
    </LinearLayout>

    <!-- Поиск по папкам -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_xs"
        android:layout_marginEnd="@dimen/spacing_l"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_s">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/search_hint"
            android:src="@drawable/ic_search"
            app:tint="@color/textSecondary" />

        <EditText
            android:id="@+id/editSourcesFilter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/sources_filter_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textTertiary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnSourcesFilterClear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/cancel"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/textSecondary" />
    </LinearLayout>

    <!-- Показать все / Скрыть все -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_m"
        android:layout_marginEnd="@dimen/spacing_l"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnSourcesAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_accent_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/sources_show_all"
                android:src="@drawable/ic_visibility"
                app:tint="?attr/gxAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sources_show_all"
                android:textColor="?attr/gxAccent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/btnSourcesNone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/sources_hide_all"
                android:src="@drawable/ic_hide"
                app:tint="@color/textSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sources_hide_all"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSources"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_xxl"
            android:scrollbars="none" />

        <!-- Сканирование -->
        <LinearLayout
            android:id="@+id/layoutSourcesScanning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtSourcesScanning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/sources_scanning"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSourcesEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xxxl"
            android:paddingEnd="@dimen/spacing_xxxl"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_accent_pill"
                android:contentDescription="@string/sources_title"
                android:padding="18dp"
                android:src="@drawable/ic_layers"
                app:tint="?attr/gxAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sources_empty_title"
                android:textColor="@color/textPrimary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/sources_empty_sub"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
