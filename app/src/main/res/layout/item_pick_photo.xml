<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1dp">

    <com.premiumlab.galleryx.ui.view.SquareCardView
        android:id="@+id/cardPick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/gxSurfaceAlt"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgPick"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/placeholder_media_square"
            android:contentDescription="@string/nav_gallery"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/viewPickDim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#40000000"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgPickCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_check_badge"
            android:contentDescription="@string/select_all"
            android:padding="4dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="?attr/gxOnAccent" />
    </com.premiumlab.galleryx.ui.view.SquareCardView>
</FrameLayout>
