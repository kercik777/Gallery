<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_h"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_m">

        <ImageView
            android:id="@+id/btnRootBack"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/textPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:id="@+id/txtRootTitle"
            android:text="@string/root_title"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4dp"
        android:paddingStart="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_s"
        android:paddingEnd="@dimen/spacing_l"
        android:id="@+id/txtRootDesc"
        android:text="@string/root_desc"
        android:textColor="@color/textSecondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_m"
        android:layout_marginEnd="@dimen/spacing_l"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_l"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/spacing_l"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/storage_internal"
            android:src="@drawable/ic_sd"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/txtCurrentPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:ellipsize="start"
            android:maxLines="2"
            android:textColor="@color/textPrimary"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDirs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_s"
            android:paddingBottom="@dimen/spacing_xxl"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/txtDirsEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/albums_empty_title"
            android:textColor="@color/textTertiary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l">

        <EditText
            android:id="@+id/editRootName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:hint="@string/root_name_hint"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/spacing_l"
            android:paddingEnd="@dimen/spacing_l"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textTertiary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnCreateRoot"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/spacing_m"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/root_create_btn"
            android:textColor="@color/onPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnPickCurrent"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/spacing_s"
            android:background="@drawable/bg_row_normal"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/root_pick_current_btn"
            android:textColor="@color/textPrimary"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
