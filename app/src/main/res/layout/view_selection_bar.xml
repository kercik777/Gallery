<?xml version="1.0" encoding="utf-8"?>
<!-- Верхняя панель режима выделения: стеклянная капсула «закрыть · N выбрано · выбрать всё».
     Занимает высоту шапки экрана (64dp), поэтому сетка не «прыгает». -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/header_h"
    android:background="?attr/gxBg"
    android:elevation="8dp"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/btnSelClose"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:contentDescription="@string/close"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:tint="@color/textPrimary" />

        <TextView
            android:id="@+id/txtSelCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSelMore"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:contentDescription="@string/viewer_options"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            android:visibility="gone"
            app:tint="@color/textPrimary" />

        <ImageView
            android:id="@+id/btnSelAll"
            android:layout_width="@dimen/icon_touch"
            android:layout_height="@dimen/icon_touch"
            android:contentDescription="@string/select_all"
            android:padding="10dp"
            android:src="@drawable/ic_select_all"
            app:tint="?attr/gxAccent" />
    </LinearLayout>
</FrameLayout>
