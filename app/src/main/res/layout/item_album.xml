<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.premiumlab.galleryx.ui.view.SquareCardView
            android:id="@+id/cardAlbum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/placeholder_media"
                    android:contentDescription="@string/albums_title"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:id="@+id/layoutCoverArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gradient_primary"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgFolderArt"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/albums_title"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/white" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgLockBadge"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="start|top"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_badge_dark"
                    android:contentDescription="@string/locked_folder"
                    android:padding="5dp"
                    android:src="@drawable/ic_lock"
                    android:visibility="gone"
                    app:tint="@color/gold" />

                <TextView
                    android:id="@+id/txtUserBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_badge_gold"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="@string/my_folders"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </com.premiumlab.galleryx.ui.view.SquareCardView>

        <ImageView
            android:id="@+id/imgCheckOverlayAlbum"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end|top"
            android:layout_margin="8dp"
            android:background="@drawable/bg_check_badge"
            android:contentDescription="@string/select_all"
            android:padding="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtAlbumName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingTop="10dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/textPrimary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtAlbumCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />
</LinearLayout>
