<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_l">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chip_active" />

    <TextView
        android:id="@+id/txtDestTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_s"
        android:text="@string/dest_move_title"
        android:textColor="@color/textPrimary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/spacing_l"
        android:scrollbars="none" />
</LinearLayout>
