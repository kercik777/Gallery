<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.premiumlab.galleryx.ui.view.ZoomableImageView
        android:id="@+id/zoomImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/nav_gallery" />

    <!-- Страница видео: поверх кадра — кнопка воспроизведения -->
    <ImageView
        android:id="@+id/btnPagePlay"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_gate_circle"
        android:contentDescription="@string/play"
        android:elevation="4dp"
        android:padding="20dp"
        android:src="@drawable/ic_play"
        android:visibility="gone"
        app:tint="@color/white" />
</FrameLayout>
