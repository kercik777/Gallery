<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Фото (с зумом) или кадр видео до начала воспроизведения -->
    <com.premiumlab.galleryx.ui.view.ZoomableImageView
        android:id="@+id/zoomImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/nav_gallery" />

    <!-- Встроенный плеер страницы видео. Касания не перехватывает —
         свайпы, тап и жест «вниз» идут в ZoomableImageView под ним -->
    <com.premiumlab.galleryx.ui.view.InlineVideoView
        android:id="@+id/pageVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/pageBuffer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/white"
        android:visibility="gone" />

    <!-- Большая кнопка play/pause поверх видео -->
    <ImageView
        android:id="@+id/btnPagePlay"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_gate_circle"
        android:contentDescription="@string/play"
        android:elevation="4dp"
        android:padding="20dp"
        android:src="@drawable/ic_play"
        android:visibility="gone"
        app:tint="@color/white" />
</FrameLayout>
