<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- РЕАЛЬНОЕ СОДЕРЖИМОЕ -->
    <LinearLayout
        android:id="@+id/layoutReal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Нижняя зона фиксированной высоты: обычный bottom bar меняется
             на ряд действий выделения без изменения высоты (без прыжков). -->
        <FrameLayout
            android:id="@+id/bottomArea"
            android:layout_width="match_parent"
            android:layout_height="80dp">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface"
                app:elevation="10dp"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />

            <include
                android:id="@+id/selectionActions"
                layout="@layout/view_selection_actions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Верхняя контекстная панель выделения: перекрывает шапку фрагмента -->
    <include
        android:id="@+id/selectionTop"
        layout="@layout/view_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_h"
        android:visibility="gone" />

    <!-- МАСКИРОВКА: пустая фальшивая галерея -->
    <LinearLayout
        android:id="@+id/layoutMasked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtMaskedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_m"
            android:paddingEnd="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_m"
            android:text="@string/nav_gallery"
            android:textColor="@color/textPrimary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressHold"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginStart="@dimen/spacing_l"
            android:layout_marginEnd="@dimen/spacing_l"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/pb_hold"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_l"
            android:paddingEnd="@dimen/spacing_l"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/spacing_s"
                android:paddingBottom="@dimen/spacing_s">

                <TextView
                    android:id="@+id/chipMaskedAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:background="@drawable/bg_chip_active"
                    android:paddingStart="16dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="7dp"
                    android:text="@string/filter_all"
                    android:textColor="@color/onPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="16dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="7dp"
                    android:text="@string/filter_photo"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="16dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="7dp"
                    android:text="@string/filter_video"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgMaskedEmpty"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:contentDescription="@string/masked_empty_title"
                    android:src="@drawable/ic_empty_art"
                    app:tint="@color/textTertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/masked_empty_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:gravity="center"
                    android:text="@string/masked_empty_sub"
                    android:textColor="@color/textTertiary"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/txtMaskedVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="@dimen/spacing_s"
            android:paddingBottom="@dimen/spacing_m"
            android:text="@string/masked_version"
            android:textColor="@color/textTertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ЭКРАН РАЗРЕШЕНИЙ -->
    <LinearLayout
        android:id="@+id/layoutPermission"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xxl"
        android:visibility="gone">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/bg_icon_circle_primary"
            android:contentDescription="@string/permission_title"
            android:padding="@dimen/spacing_xxl"
            android:src="@drawable/ic_sd"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/permission_title"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/permission_desc"
            android:textColor="@color/textSecondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnGrant"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/spacing_xxxl"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/permission_btn"
            android:textColor="@color/onPrimary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/permission_note"
            android:textColor="@color/textTertiary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
