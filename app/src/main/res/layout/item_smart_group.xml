<?xml version="1.0" encoding="utf-8"?>
<!-- Группа «умных» альбомов: заголовок секции + стеклянная карточка со строками -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_s"
    android:paddingEnd="@dimen/spacing_s">

    <TextView
        android:id="@+id/txtSmartTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:paddingStart="@dimen/spacing_s"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_s"
        android:paddingBottom="@dimen/spacing_s"
        android:textAllCaps="true"
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutSmartRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>
