<?xml version="1.0" encoding="utf-8"?>
<!-- Видеоредактор (уровень GorillaGallery): обрезка, скорость, звук/громкость, фильтры,
     кадрирование/поворот/отражение; undo/redo; экспорт Media3 Transformer -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B10"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Верхняя панель: Отмена | ВИДЕО | undo/redo | Готово -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btnVeClose"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_editor_cancel"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:text="@string/cancel"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtVeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="@string/video_editor_label"
                android:textColor="#85FFFFFF"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnVeUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/editor_undo"
                android:padding="9dp"
                android:src="@drawable/ic_undo"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnVeRedo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/editor_redo"
                android:padding="9dp"
                android:src="@drawable/ic_redo"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/btnVeSave"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_editor_done"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:text="@string/editor_done"
                android:textColor="?attr/gxAccent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Превью -->
        <FrameLayout
            android:id="@+id/veVideoBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="#000000">

            <com.premiumlab.galleryx.ui.view.InlineVideoView
                android:id="@+id/veVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <com.premiumlab.galleryx.editor.VideoCropOverlay
                android:id="@+id/veCrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnVePlay"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass_round"
                android:contentDescription="@string/play"
                android:padding="16dp"
                android:src="@drawable/ic_play"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Подсказка режима -->
        <TextView
            android:id="@+id/txtVeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:textColor="#9999B0"
            android:textSize="12sp" />

        <!-- Панель текущего режима -->
        <FrameLayout
            android:id="@+id/vePanelContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="140dp">

            <!-- Видео: диапазон + плёнка обрезки + скорость -->
            <LinearLayout
                android:id="@+id/vePanelTrim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtVeRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <FrameLayout
                    android:id="@+id/veTrimBox"
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/rowVeSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Звук: без звука + громкость -->
            <LinearLayout
                android:id="@+id/vePanelAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/txtVeVolume"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/seekVeVolume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="200"
                        android:progress="100"
                        android:progressTint="?attr/gxAccent"
                        android:thumbTint="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowVeAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>

            <!-- Фильтры: миниатюры кадра -->
            <HorizontalScrollView
                android:id="@+id/vePanelFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/rowVeFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp" />
            </HorizontalScrollView>

            <!-- Кадр: поворот/отражение/сброс + пропорции -->
            <LinearLayout
                android:id="@+id/vePanelCrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="10dp">

                    <ImageView
                        android:id="@+id/btnVeRotate"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_editor_icon"
                        android:contentDescription="@string/editor_rotate"
                        android:padding="11dp"
                        android:src="@drawable/ic_rotate"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/btnVeFlip"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_editor_icon"
                        android:contentDescription="@string/editor_flip"
                        android:padding="11dp"
                        android:src="@drawable/ic_flip"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/btnVeCropReset"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_editor_icon"
                        android:contentDescription="@string/editor_reset"
                        android:padding="11dp"
                        android:src="@drawable/ic_restore"
                        app:tint="@color/white" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/rowVeAspects"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp" />
                </HorizontalScrollView>
            </LinearLayout>
        </FrameLayout>

        <!-- Вкладки режимов -->
        <LinearLayout
            android:id="@+id/rowVeModes"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#141420"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- Экспорт -->
    <FrameLayout
        android:id="@+id/layoutVeProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <ProgressBar
                android:id="@+id/veProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminate="true"
                android:max="100"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="?attr/gxAccent" />

            <TextView
                android:id="@+id/txtVeProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:text="@string/video_editor_saving"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnVeCancelExport"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_editor_cancel"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/cancel"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
